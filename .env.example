# Copy this file to ".env" and change SECRET_KEY before use.
# Never share the real .env file or put it on GitHub.

# The key used to sign login passes. Any long random text, 32 characters or more.
# The server refuses to start while this still says "change-me".
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# Password for the database inside Docker.
POSTGRES_PASSWORD=change-me-too

# The moment the game world begins, in Lagos time. The game calendar counts from here.
# Read ONCE, when the world is first created. After that the world remembers its own
# start and this line is ignored. One real week is one game quarter, so a start eight
# weeks in the past gives every company eight quarters of accounts on the first run.
WORLD_START=2026-08-03T00:00:00+01:00

# "false" only while running on your own computer. Must be "true" on a real website.
COOKIE_SECURE=false

# The service that sends the sign-up confirmation code by email.
# Leave SMTP_HOST empty on your own computer: the code is then shown on the
# sign-up screen instead. A real website (COOKIE_SECURE=true) must fill these in,
# with the details given by an email provider, or the server refuses to start.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@localhost
